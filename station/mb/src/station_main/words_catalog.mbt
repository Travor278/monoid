pub let station_en : String = "{\"station.title.noAgent\":\"This chat has no available agent\",\"station.title.unsupported\":\"This chat's agent cannot regenerate titles yet\",\"station.title.empty\":\"There is no conversation text to make a title from yet\",\"station.title.failed\":\"Couldn't generate a title; try again\",\"station.title.changed\":\"The title changed while it was being generated; try again\",\"station.title.timeout\":\"Generating a title timed out; try again\",\"station.network.managersOnly\":\"Only owners and admins can change network settings\",\"station.restart.managersOnly\":\"Only owners and admins can restart the station\",\"station.restart.cannot\":\"This station isn't run by its launcher, so it can't be restarted from here\",\"station.adb.allowPrompt\":\"Tap Allow on the phone's “Allow USB debugging?” prompt\",\"station.adb.codeDigits\":\"The pairing code is 6 digits\",\"station.adb.grantFailed\":\"Couldn't grant: {said}\",\"station.adb.grantRefused\":\"The phone doesn't let adb grant permissions: in Developer options, turn on “Disable permission monitoring” (ColorOS) or “USB debugging (Security settings)” (MIUI), then try again\",\"station.adb.granted\":\"The app can now turn on wireless debugging itself\",\"station.adb.install\":\"No adb on this station: install Android platform-tools (macOS: brew install android-platform-tools), then share again\",\"station.adb.serverDown\":\"adb did not start on the station\",\"station.adb.noAdb\":\"No adb on this station\",\"station.adb.noPackage\":\"The phone didn't send the app's package name\",\"station.adb.notSharing\":\"This device isn't sharing debugging\",\"station.adb.pairFailed\":\"Pairing failed: {said}\",\"station.adb.paired\":\"Paired\",\"station.adb.pairingClosed\":\"Pairing isn't open on the phone: in Wireless debugging, tap “Pair device with pairing code”\",\"station.adb.unknownAsk\":\"Unknown adb request\",\"station.adb.unpaired\":\"This station isn't paired with the phone yet\",\"station.adb.wirelessOff\":\"Wireless debugging is off on the phone\",\"station.agentEnv.badName\":\"Line {line}: {name} isn't a valid variable name\",\"station.agentEnv.managersOnly\":\"Only workspace admins can change agent environment variables\",\"station.agentEnv.notPair\":\"Line {line} isn't in the form NAME=value\",\"station.agentEnv.tooLong\":\"Line {line}: the value is too long (at most {most} characters)\",\"station.agentEnv.tooMany\":\"Too many variables (at most {most})\",\"station.feishu.answerEmpty\":\"Write an answer first\",\"station.feishu.answered\":\"{name} answered: {answer}\",\"station.feishu.answeredBefore\":\"This question was already answered\",\"station.feishu.badAppId\":\"The App ID looks like cli_xxx\",\"station.feishu.badSecret\":\"The App ID or App Secret is wrong: {error}\",\"station.feishu.botUnread\":\"Can't read this app's bot: {error}\",\"station.feishu.done\":\"Done · took {time}\",\"station.feishu.history\":\"Execution history\",\"station.feishu.minutes\":\"{m} min {s} s\",\"station.feishu.noBot\":\"This app's bot isn't turned on\",\"station.feishu.noLongConnection\":\"Can't receive events over a long connection: {error}\",\"station.feishu.noSecret\":\"Enter the App Secret\",\"station.feishu.notRegistered\":\"No app made by that scan; scan again\",\"station.comma.notConnected\":\"Comma is not connected\",\"station.comma.noRuntime\":\"This station runs no {runtime} agents\",\"station.comma.oneModel\":\"A Task runs on one model on a still.fail station; start a new Task to run another\",\"station.comma.member\":\"Comma member\",\"station.comma.done\":\"Done\",\"station.comma.need\":\"Waiting for you\",\"station.comma.badLine\":\"Paste the whole line Comma's still.fail plugin shows, starting with comma\",\"station.feishu.registerFailed\":\"Couldn't start making the app by scan: {error}\",\"station.feishu.seconds\":\"{s} s\",\"station.feishu.sent\":\"Sent\",\"station.screen.notFound\":\"This screen is no longer on this station\",\"station.screen.notClosed\":\"This screen can't be closed from here\",\"station.screen.viewGone\":\"This connection has already ended\",\"station.screen.viewNotEnded\":\"An agent's connection can't be ended from here\",\"station.screen.endedBy\":\"{by} ended this connection\",\"station.screen.noDebug\":\"Nothing to debug on this screen\",\"station.screen.noApp\":\"That app isn't installed on this simulator\",\"station.screen.badUrl\":\"That isn't a link\",\"station.screen.noBrowser\":\"No Chrome browser is available on this station\",\"station.screen.notBrowser\":\"This screen isn't a browser tab\",\"station.screen.userOnly\":\"This is a person's own browser tab; agents cannot view or control it\",\"station.screen.readOnlySleeping\":\"Read-only members can't wake a sleeping tab\",\"station.screen.badPlace\":\"That isn't a place: give a latitude and a longitude\",\"station.screen.notAnApp\":\"There is no app in that file: give an .ipa, or a .zip with a .app in it, built for the simulator\",\"station.screen.noSetting\":\"That setting can't be changed\",\"station.screen.unsupported\":\"Only macOS and Windows stations' own screens can be viewed for now\",\"station.screen.noHelper\":\"This station's release has no screen helper (stillfail-screen); update the station\",\"station.screen.linuxNoDisplay\":\"This Linux station has no accessible desktop. Run the station in the desktop user's session.\",\"station.screen.linuxWayland\":\"Linux Wayland desktop sharing is not supported yet; an X11 session can be used.\",\"station.screen.linuxTools\":\"Linux desktop sharing requires ffmpeg with X11 support and xdotool.\",\"station.screen.linuxToolsPreparing\":\"Preparing the components for Linux desktop control. Open it again when they are ready.\",\"station.screen.linuxToolsFailed\":\"The Linux desktop control components could not be prepared automatically. Check the station's network and package sources, or install ffmpeg with X11 support and xdotool on that machine, then try again.\",\"station.screen.linuxUnavailable\":\"The Linux X11 desktop couldn't be reached. Check that the station runs in the desktop user's session.\",\"station.screen.linuxPortalConsent\":\"Allow screen sharing and remote control on the Linux desktop, then open it again.\",\"station.screen.linuxPortalUnavailable\":\"The Wayland desktop could not be reached. Check that the desktop is signed in and has a desktop portal, PipeWire, Python GI and the GStreamer PipeWire/JPEG components installed.\",\"station.screen.linuxDesktopStarting\":\"Connecting to the Linux desktop. Open it again shortly.\",\"station.screen.linuxX11FallbackUnavailable\":\"X11 desktop control could not start. Check that the desktop is signed in and has Python GI, the GStreamer X11/JPEG components and the XTest library installed.\",\"station.screen.linuxTextUnsupported\":\"This app cannot receive that text, or its input has a selection. Clear the selection and try again; web pages can also be typed in from their browser view.\",\"station.screen.codec\":\"This screen is sent as {codec}, which this app can't show\",\"station.screen.debugFailed\":\"It didn't work: {said}\",\"station.screen.failed\":\"The screen couldn't be opened: {said}\",\"station.screen.captureEnded\":\"The picture stopped: {said}. Tap Open again to retry; if it keeps happening, check that this station's desktop is still signed in.\",\"station.screen.captureEndedUnsaid\":\"the capture exited\",\"station.screen.captureOff\":\"This Mac hasn't let {app} record its screen yet.\",\"station.screen.controlOff\":\"This Mac hasn't allowed {app} to control it yet (Accessibility), so the screen can be viewed but not controlled.\",\"station.screen.bothOff\":\"This Mac hasn't let {app} record its screen or control it yet.\",\"station.screen.asking\":\"A permission window is open on that Mac: click Allow there, drag {app} into the list in System Settings, then open the screen again.\",\"station.screen.toAsk\":\"Opening the screen shows a permission window on that Mac.\",\"station.helper.window.title\":\"Let still.fail see and control this Mac\",\"station.helper.window.subtitle\":\"Someone asked to view this Mac's screen from the still.fail app. still.fail Helper uses these permissions only while someone has it open.\",\"station.helper.window.capture\":\"Screen Recording\",\"station.helper.window.captureWhy\":\"To show this screen in the still.fail app\",\"station.helper.window.control\":\"Accessibility\",\"station.helper.window.controlWhy\":\"To click and type for the person controlling it\",\"station.helper.window.allow\":\"Allow\",\"station.helper.window.done\":\"Permissions enabled\",\"station.helper.window.drag\":\"Drag the app below into the list above to allow **{grant}**.\",\"station.helper.window.step\":\"Step {n}\",\"station.helper.window.dragLabel\":\"Drag\",\"station.helper.window.grant\":\"Permission\",\"station.helper.window.filesTitle\":\"Let still.fail open folders on this Mac\",\"station.helper.window.filesSubtitle\":\"Someone opened a folder macOS protects in still.fail's Files. Click Allow and macOS asks once; still.fail Helper reads and writes it only while someone browses it.\",\"station.helper.window.documents\":\"Documents\",\"station.helper.window.documentsWhy\":\"To browse, read and write Documents in Files\",\"station.helper.window.desktop\":\"Desktop\",\"station.helper.window.desktopWhy\":\"To browse, read and write the Desktop in Files\",\"station.helper.window.downloads\":\"Downloads\",\"station.helper.window.downloadsWhy\":\"To browse, read and write Downloads in Files\",\"station.helper.window.removable\":\"External disks\",\"station.helper.window.removableWhy\":\"To browse, read and write disks attached to this Mac in Files\",\"station.helper.window.network\":\"Network disks\",\"station.helper.window.networkWhy\":\"To browse, read and write network disks this Mac is connected to in Files\",\"station.helper.window.localNetwork\":\"Local Network\",\"station.helper.window.deniedWhy\":\"Refused before: Allow opens System Settings › Files and Folders, to turn it on there\",\"station.helper.window.askTitle\":\"Allow still.fail to use these permissions on this Mac\",\"station.helper.window.askSubtitle\":\"Someone in still.fail asked for the permissions below. still.fail Helper uses them only while the feature that needs them is in use.\",\"station.admin.badChannel\":\"channel must be stable or beta\",\"station.admin.badFast\":\"fast must be a boolean or null\",\"station.admin.badN\":\"n must be an integer\",\"station.admin.badOn\":\"on must be true or false\",\"station.admin.badOption\":\"option must be one the agent offered\",\"station.admin.badRuntime\":\"runtime must be claude, codex or dsh\",\"station.admin.emptyMessage\":\"Message is empty\",\"station.admin.footprintRemoved\":\"Storage stats removed\",\"station.admin.fromAndTo\":\"Provide from and to together\",\"station.admin.loginOnMachine\":\"This Profile uses the machine's sign-in; sign in on that machine\",\"station.admin.loginSubscriptionOnly\":\"Only subscription accounts need to sign in\",\"station.admin.noLocalSession\":\"No such local session: {id}\",\"station.admin.notInteger\":\"{name} must be an integer\",\"station.admin.nothingWaiting\":\"Nothing in this message is awaiting your answer\",\"station.admin.postOnlyStillfail\":\"You can only post in still.fail chats\",\"station.admin.renameOnlyStillfail\":\"You can only rename still.fail chats\",\"station.admin.updateClientForOption\":\"Update the app to choose this option; it won't be sent to the agent\",\"station.admin.updatesManagersOnly\":\"Only workspace owners or admins can update the station and runtimes\",\"station.admin.updatesUnavailable\":\"This station can't be updated here\",\"station.admin.waitChanged\":\"This wait has changed; refresh and try again\",\"station.author.admin\":\"Admin\",\"station.card.chosen\":\"Chose “{option}”\",\"station.card.endedByMessage\":\"Closed: {name} wrote a new message\",\"station.card.endedByMessageBare\":\"Closed: a new message came\",\"station.card.replied\":\"{name} replied\",\"station.card.repliedBare\":\"Replied\",\"station.card.endedReplaced\":\"Closed: a newer question replaced it\",\"station.card.endedWithdrawn\":\"Withdrawn\",\"station.card.endedClosed\":\"Closed\",\"station.chat.directMessage\":\"DM\",\"station.chat.quotedOnly\":\"Quoted a message\",\"station.chat.untitled\":\"New chat\",\"station.claudeAuth.badResponse\":\"Claude sign-in renewal returned a bad response\",\"station.claudeAuth.changedDuringRefresh\":\"Claude sign-in changed during renewal; try again\",\"station.claudeAuth.credentialsUnreadable\":\"Can't read Claude sign-in credentials\",\"station.claudeAuth.expiredNoRefresh\":\"Claude sign-in expired and can't be renewed; sign in again\",\"station.claudeAuth.keychainAccount\":\"Can't determine the Claude keychain account name\",\"station.claudeAuth.keychainSaveFailed\":\"Couldn't save renewed Claude sign-in to keychain\",\"station.claudeAuth.keychainTimeout\":\"Claude keychain save timed out\",\"station.claudeAuth.keychainUnreadable\":\"Can't read Claude keychain credentials\",\"station.claudeAuth.keychainWrite\":\"Couldn't write to the keychain command\",\"station.claudeAuth.lockFailed\":\"Couldn't get the Claude renewal lock\",\"station.claudeAuth.noAccessToken\":\"Claude renewal response lacks access_token\",\"station.claudeAuth.noCredentials\":\"No Claude sign-in credentials found; sign in again\",\"station.claudeAuth.noExpiry\":\"Claude renewal response lacks expiry\",\"station.claudeAuth.refreshFailed\":\"Claude sign-in renewal failed; try again later\",\"station.claudeAuth.refreshLocked\":\"Another Claude process is renewing; try again later\",\"station.claudeAuth.refreshRefused\":\"Claude sign-in renewal refused ({status}); sign in again\",\"station.claudeAuth.refreshUnavailable\":\"Can't renew Claude sign-in now ({status}); try again later\",\"station.claudeAuth.saveFailed\":\"Couldn't save renewed Claude sign-in\",\"station.cli.badChannel\":\"channel must be stable or beta, not {channel}\",\"station.cli.held\":\"Another still.fail station is running on this data directory ({dir}); only one station can run on a data directory on one machine\",\"station.cli.joined\":\"Joined workspace “{workspace}” as station “{name}” ({id})\",\"station.cli.lock.aside\":{\"one\":\", and {n} record kept off the chain in use\",\"other\":\", and {n} records kept off the chain in use\"},\"station.cli.lock.broken\":\"Security mode: this station's lock.json is invalid, so all connections are refused. Run `stillfail lock reset` to let still.fail's servers manage access again\",\"station.cli.lock.none\":\"Security mode: off (still.fail's servers manage access)\",\"station.cli.lock.pending\":\"This station enters security mode once it receives the workspace's trusted list. Verify the station in still.fail with security code {code}\",\"station.cli.lock.reset\":\"This station has left security mode; still.fail's servers manage access again. To turn it back on, use a trusted device\",\"station.cli.lock.resetWorkspace\":\"This station no longer keeps a security mode record for workspace {workspace}. If that workspace is in security mode, the station takes none of its members until it is protected there again from a trusted device\",\"station.cli.lock.noneWorkspace\":\"This station keeps no security mode record for workspace {workspace}\",\"station.cli.lock.status\":\"Security mode: on, record {seq} ({hash}…), {members} members, {devices} devices, {stations} stations\",\"station.cli.noAnswer\":\"The running station didn't answer (it may still be starting); try again in a moment\",\"station.cli.rig.isRig\":\"This machine is a tasks-only station of workspace “{workspace}” and cannot join as a full station too. To change that, make it a full station in still.fail, or remove it from the workspace first\",\"station.cli.rig.isStation\":\"This machine is a full station of workspace “{workspace}” and cannot join as a tasks-only station too. To change that, make it tasks only in still.fail, or remove it from the workspace first\",\"station.cli.rig.joined\":\"Joined workspace “{workspace}” as station “{name}” ({id}), tasks only, owned by {owner}\",\"station.cli.rig.pending\":\"This station enters security mode once it receives the workspace's trusted list. Its owner checks the security code {code} in still.fail\",\"station.cli.rig.status\":\"Mode: tasks only, owned by {owner} (it takes only their trusted devices' approval, list {person}…). It runs no agents; it only runs tasks the workspace's stations send\",\"station.cli.rig.working\":\"Work: normal (waiting for tasks from stations)\",\"station.cli.signalFailed\":\"Couldn't notify the running station (pid {pid}): {error}\",\"station.cli.status.cloud\":\"Cloud: {origin}\",\"station.cli.status.data\":\"Data directory: {path}\",\"station.cli.status.idleRemoved\":\"Work: stopped. On removal, the station closed its Slack connections and stopped running agents and jobs (the reason is at the end of each job log). It checks with the cloud every 10 minutes and resumes automatically once readmitted. To rejoin: {join}\",\"station.cli.status.idleUnjoined\":\"Work: stopped. A station outside a workspace doesn't connect to Slack or run agents and jobs. To join: {join}\",\"station.cli.status.join\":\"stillfail station enroll <cloud> <token> (generate the token under “Add station” in still.fail)\",\"station.cli.status.name\":\"Station name: {name} ({id})\",\"station.cli.status.noWorkspace\":\"Workspace: not joined\",\"station.cli.status.notConnectedYet\":\"Not connected yet\",\"station.cli.status.notRunning\":\"Station: not running\",\"station.cli.status.offline\":\"Online: no\",\"station.cli.status.offlineNotRunning\":\"Online: no (the station isn't running)\",\"station.cli.status.offlineWhy\":\"Online: no ({why})\",\"station.cli.status.onlineSince\":\"Online: yes (since {at})\",\"station.cli.status.removed\":\"Removed: from workspace “{workspace}”, {at}, {how}\",\"station.cli.status.removedCode\":\"code {code}\",\"station.cli.status.removedOn404\":\"The cloud reported on connect that this station is no longer in the workspace (404)\",\"station.cli.status.removedOnClose\":\"The cloud reported it when closing the connection (4004)\",\"station.cli.status.running\":\"Station: running (pid {pid}, version {version})\",\"station.cli.status.working\":\"Work: normal (connected to Slack, running agents and jobs)\",\"station.cli.status.workspace\":\"Workspace: {name} ({id})\",\"station.cli.status.stopped\":\"Work: stopped (the station isn't running: it doesn't connect to Slack or run agents and jobs). To start it: stillfail start\",\"station.cli.status.unresponsive\":\"Work: failing (the station's process hasn't responded for {secs} s; devices and agents are waiting on it. The launcher ends and restarts it by itself; if this persists for a few minutes, restart the station service on this machine)\",\"station.cli.status.frontDown\":\"Work: failing (the local mesh front is disconnected and reconnecting; devices can't reach this station until it's back. The launcher restarts the front by itself)\",\"station.cli.status.keyConflict\":\"Work: failing (another machine or process is using this station's key, and each keeps replacing the other's connection, so devices connect and drop; stop the station running elsewhere, or enroll one of them again as a new station)\",\"station.cli.status.limited\":\"Work: limited (not connected to still.fail cloud yet, retrying; devices may not find this station until then — see the “Online” line above for why)\",\"station.cli.unknownChannel\":\"Unknown channel {channel}\",\"station.connect.heldElsewhere\":\"This bot is already connected on the station {station}. A connect runs on one station of the workspace: move it there instead of adding it again.\",\"station.connect.moveWhere\":\"Pick another station of this connect's workspace to move it to.\",\"station.retire.moving\":\"This station is moving this workspace's chats to another station, so this message was not sent. Once they are moved, send it again in the chat on that station.\",\"station.retire.card.start.title\":\"Move the chats of station “{name}” to “{to}”\",\"station.retire.card.start.moves\":\"Going along: {chats} chats{archived}, {connects} connects{accounts}; running background jobs are started again there.\",\"station.retire.card.start.archived\":\", {n} archived chats\",\"station.retire.card.start.accounts\":\", {n} accounts ({names})\",\"station.retire.card.start.stays\":\"Not moving: {outside}{accountsStay}tools installed on the machine, and config.json's sandboxes and agentEnv.\",\"station.retire.card.start.outside\":\"{n} chats whose working directory is not the station's own (they stay where they are); \",\"station.retire.card.start.accountsStay\":\"the accounts, which stay on this station ({names}); \",\"station.retire.card.start.room\":\"The other station has {free} free.\",\"station.retire.card.start.roomNoGit\":\"The other station has {free} free, and no git.\",\"station.retire.card.start.next\":\"The files are sent first while the chats keep working; once they are there you are asked again to confirm “Pause the chats and hand over”.\",\"station.retire.card.start.confirm\":\"Start moving\",\"station.retire.card.start.confirmDetail\":\"Send the files first while the chats keep working; confirm the hand-over after\",\"station.retire.card.start.decline\":\"Not now\",\"station.retire.card.handOver.sent\":\"The files of “{name}” are on “{to}”: {files} files, {size}. What changes from now on is sent at the hand-over.\",\"station.retire.card.handOver.sentIn\":\"The files of “{name}” are on “{to}”: {files} files, {size}, in {minutes} min. What changes from now on is sent at the hand-over.\",\"station.retire.card.handOver.what\":\"Once confirmed, this workspace's chats on “{name}” pause and are handed over to “{to}”; they don't answer meanwhile, and new messages from the platforms are kept and passed on. If the hand-over fails, the chats go back to work by themselves.\",\"station.retire.card.handOver.confirm\":\"Pause the chats and hand over\",\"station.retire.card.handOver.confirmDetail\":\"Pause this workspace's chats, send what changed and hand them over\",\"station.retire.card.handOver.decline\":\"Not yet\",\"station.retire.card.declineDetail\":\"Tell the agent; nothing is done\",\"station.retire.card.owners\":\"An owner or admin of the workspace confirms this in the still.fail app.\",\"station.retire.card.thisStation\":\"this one\",\"station.retire.card.otherStation\":\"another station\",\"station.retire.ownersOnly\":\"Only the workspace's owners and admins can confirm moving a station\",\"station.retire.askGone\":\"This card's request is gone: ask the agent to ask again\",\"station.retire.off\":\"Move chats away and remove is switched off for now: it is being fixed, and opens again once it is\",\"station.connect.stationAway\":\"The station this chat runs on ({station}) can't be reached right now, so your message didn't get to it. Try again once it's back online.\",\"station.connect.ownerEmail\":\"The owner must be an email address\",\"station.connect.ownerWho\":\"Only workspace owners, admins or the current owner can change the owner\",\"station.connect.stationManagersOnly\":\"Only a workspace owner or admin can change which station a connect runs on\",\"station.core.badAddress\":\"Unknown station address: {address}\",\"station.core.connecting\":\"Connecting\",\"station.core.disconnected\":\"Disconnected\",\"station.core.fileUnreadable\":\"Couldn't read file\",\"station.core.fileOldStation\":\"This station is too old to send big files; update it first\",\"station.core.uploadOldStation\":\"This station is too old to take files over 50 MB; update it first\",\"station.core.localGone\":\"Local page no longer available\",\"station.core.noChat\":\"No such chat\",\"station.core.badBatch\":\"Incomplete response to a batched read from the station\",\"station.core.incompleteReply\":\"Couldn't load all the records; try again\",\"station.core.invalidReply\":\"Couldn't read the response; try again\",\"station.core.stationTooOld\":\"This station is too old for this app. Update the station.\",\"station.core.noMessageNumber\":\"Station reply lacks a message number\",\"station.core.noSoftwareId\":\"Software has no id\",\"station.core.offline\":\"Station unreachable\",\"station.core.oneWay\":\"Only one route; nothing to test\",\"station.core.openingPreviewSocket\":\"Opening service WebSocket\",\"station.core.previewNoSocket\":\"Previews here don't support WebSockets yet\",\"station.core.previewSocketTimeout\":\"Service WebSocket didn't open: station not responding\",\"station.core.progressUnreadable\":\"Can't read update progress; later updates not started\",\"station.core.replaced\":\"Switched connection\",\"station.core.requestFailed\":\"Request failed ({status})\",\"station.core.retryInDetails\":\"retry in details\",\"station.core.sessionDeleted\":\"Session deleted\",\"station.core.streamIdle\":\"Station connection not responding\",\"station.core.unconfirmed\":\"Couldn't confirm it went through: {why}\",\"station.core.updateBusy\":\"Another update is in progress; wait for it to finish\",\"station.core.updateFailed\":\"{name} failed to update: {error}\",\"station.core.updateUnfinished\":\"Update not finished; later ones not started. See progress in details\",\"station.core.updatesUnsupported\":\"Station doesn't support updates yet\",\"station.creator.localPage\":\"Local admin page\",\"station.decisions.archive\":\"Archive suggested\",\"station.decisions.failed\":\"Check failed\",\"station.decisions.keep\":\"Not suggested\",\"station.decisions.managersOnly\":\"Only workspace managers can set up automatic decisions\",\"station.decisions.managersOnlyReview\":\"Only workspace managers can run automatic decisions\",\"station.decisions.managersOnlyRefresh\":\"Only workspace managers can refresh decision models\",\"station.decision